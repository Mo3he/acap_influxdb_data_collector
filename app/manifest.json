{
  "schemaVersion": "2.0.0",
  "acapPackageConf": {
    "setup": {
      "friendlyName": "InfluxDB Data Collector",
      "appName": "acap_influxdb",
      "vendor": "Mo3he",
      "vendorId": "5741c1fb91",
      "vendorUrl": "https://github.com/Mo3he",
      "runMode": "respawn",
      "version": "1.1.2",
      "compatibleOsVersions": [
        { "max": "13" }
      ]
    },
    "configuration": {
      "settingPage": "index.html",
      "httpConfig": [
        {"name": "app", "access": "admin", "type": "fastCgi"},
        {"name": "settings", "access": "admin", "type": "fastCgi"},
        {"name": "status", "access": "admin", "type": "fastCgi"},
        {"name": "test", "access": "admin", "type": "fastCgi"},
        {"name": "debug", "access": "admin", "type": "fastCgi"}
      ]
    }
  },
  "resources": {
    "dbus": {
      "requiredMethods": [
        "com.axis.HTTPConf1.VAPIXServiceAccounts1.GetCredentials"
      ]
    }
  }
}
